{
  "compileOnSave": false,
  "buildOption": {
    "externalNativeOptions": {
      "path": "",
      "arguments": "",
      "abiFilters": ["arm64-v8a", "x86_64"]
    },
    "arkOptions": {
      "obfuscation": {
        "ruleOptions": {
          "enable": false,
          "files": ["./obfuscation-rules.txt"]
        },
        "consumerFiles": ["./consumer-rules.txt"]
      }
    }
  },
  "buildModeSet": [
    { "name": "debug" },
    { "name": "release" }
  ]
}
