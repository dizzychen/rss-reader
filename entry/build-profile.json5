{
  "compileOnSave": false,
  "targets": [
    {
      "name": "default",
      "applyToProducts": [
        "default"
      ]
    }
  ],
  "buildOption": {
    "arkOptions": {
      "obfuscation": {
        "ruleOptions": {
          "enable": false,
          "files": ["./obfuscation-rules.txt"]
        },
        "consumerFiles": ["./consumer-rules.txt"]
      }
    }
  },
  "buildModeSet": [
    { "name": "debug" },
    { "name": "release" }
  ]
}
