{
  "modelVersion": "6.0.0",
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    }
  ],
  "buildOption": {
    "targets": ["phone"]
  },
  "products": [
    {
      "name": "default",
      "signingConfig": "default",
      "compatibleSdkVersion": 20,
      "runtimeOS": "HarmonyOS",
      "buildOption": {
        "strictMode": {
          "caseSensitiveCheck": true,
          "useNormalizedOHMUrl": true
        }
      }
    }
  ],
  "signingConfigs": []
}
